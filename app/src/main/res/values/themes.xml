<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ExpenseTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>

        <item name="colorSecondary">@color/md_theme_light_secondary</item>

        <!-- Background & surface -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/md_theme_light_primary</item>

        <!-- Font -->
<!--        <item name="android:fontFamily">@font/poppins_regular</item>-->
    </style>

    <style name="Theme.ExpenseTracker" parent="Base.Theme.ExpenseTracker" />


    <style name="Theme.ExpenseTracker.Splash" parent="Theme.SplashScreen">
        <!-- Splash background -->
        <item name="windowSplashScreenBackground">@color/white</item>
        <!-- App icon in splash -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_income</item>
        <!-- Icon background (optional) -->
        <item name="windowSplashScreenIconBackgroundColor">@color/white</item>
        <!-- After splash, go to main theme -->
        <item name="postSplashScreenTheme">@style/Theme.ExpenseTracker</item>

    </style>
</resources>